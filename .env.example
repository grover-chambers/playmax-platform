# ── PlayMax Platform — Environment Variables ────────────────
# Copy this file to .env.local and fill in your Supabase credentials.
#
#   cp .env.example .env.local
#
# Get these from your Supabase project dashboard:
#   Project Settings → API → Project URL & Anon Key (publishable key)

# Supabase project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/publishable key (not the secret service_role key!)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Optional: OAuth providers ─────────────────────────────
# For Google OAuth, configure in Supabase Dashboard:
#   Authentication → Providers → Google
# Add callback URL: https://your-domain.vercel.app/auth/callback
