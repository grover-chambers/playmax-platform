# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Service role key (secret - never expose to browser)
# Used by demo-login API to auto-create/update demo users.
# Get it from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email delivery)
# Sign up at https://resend.com → API Keys → Create key
RESEND_API_KEY=re_xxxxxxxxxxxx
# Your verified domain (add DNS TXT record in Resend dashboard).
# Remove this line to use onboarding@resend.dev (works immediately).
RESEND_DOMAIN=example.com

# Site URL — used in email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe webhook secret — verify Stripe signature on /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Background report worker auth — Bearer token for /api/worker/health
WORKER_HEALTH_TOKEN=

# Rate limiting — HMAC pepper for hashed client keys (api_rate_limits)
RATE_LIMIT_PEPPER=

# Cron / scheduled jobs shared secret
CRON_SECRET=

# NAMPARK RMS module ingestion — Bearer token for /api/modules/nampark/ingest
# Shared secret with the NAMPARK RMS server (never exposed to browsers)
MODULE_INGEST_SECRET=

# NAMPARK RMS base URL (no trailing slash) — used by admin field-team provisioning
NAMPARK_RMS_URL=https://rms.example.com

# NAMPARK RMS admin rep API shared secret — sent as Bearer token (never exposed to browsers)
REP_ADMIN_SECRET=

# Nice_OS census engine (Kanini field data)
# Anon key of the Nice_OS Supabase project + a read-only portal service account
# (role: super_admin) whose session the server uses to read reps/outlets/visits/submissions.
CENSUS_SUPABASE_URL=https://zsprlozgdxzxeevvetmg.supabase.co
CENSUS_SUPABASE_ANON_KEY=
CENSUS_PORTAL_EMAIL=portal@marketlink.co.ke
CENSUS_PORTAL_PASSWORD=
