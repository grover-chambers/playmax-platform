# Copy to .env and fill in real values, or pass via --dart-define.
# The client key is now a Supabase publishable key (sb_publishable_...),
# used by the app as the Supabase ANON_KEY for public/RBAC-scoped access.
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=sb_publishable_placeholder-key
